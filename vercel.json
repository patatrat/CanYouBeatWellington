{
  "rewrites": [
    { "source": "/.well-known/webfinger", "destination": "/api/well-known/webfinger" },
    { "source": "/actor/inbox",     "destination": "/api/actor/inbox" },
    { "source": "/actor/outbox",    "destination": "/api/actor/outbox" },
    { "source": "/actor/followers", "destination": "/api/actor/followers" },
    { "source": "/actor",           "destination": "/api/actor" },
    { "source": "/(.*)",            "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://analytics.radomski.co.nz https://vercel.live; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://vercel.live; font-src 'self' https://vercel.live; connect-src 'self' https://api.open-meteo.com https://qumelyuoeutlnnouhguo.supabase.co https://vitals.vercel-insights.com https://analytics.radomski.co.nz wss://ws-us3.pusher.com https://sockjs-us3.pusher.com; frame-src https://www.youtube.com https://vercel.live; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
