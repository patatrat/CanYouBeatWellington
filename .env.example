# Supabase — get these from your Supabase project settings → API
VITE_SUPABASE_URL=https://qumelyuoeutlnnouhguo.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ActivityPub federation
# Generate a key pair with:
#   openssl genrsa -out ap_private.pem 2048
#   openssl rsa -in ap_private.pem -pubout -out ap_public.pem
# Store the PEM contents with literal \n between lines (GitHub/Vercel handle multiline secrets this way).
AP_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----
AP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEowIB...\n-----END RSA PRIVATE KEY-----

# Vercel KV (Upstash Redis) — create a KV store in the Vercel dashboard and link it to this project.
# These vars are auto-injected in Vercel Functions; add them to GitHub secrets for the Actions fan-out step.
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_TOKEN=your_kv_token_here
