# Neon — pooled connection for app queries, unpooled (direct) for migrations
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# Bearer tokens for the daily cron (/api/cron/daily-weather) and the admin
# routes (/api/admin/resolve-sporting, /api/admin/refresh-note,
# /api/admin/send-move) — any reasonably random string works, e.g.
# `openssl rand -hex 32`.
CRON_SECRET=your_cron_secret_here
ADMIN_SECRET=your_admin_secret_here

# ActivityPub federation — the old (currently live) actor's key.
# Generate a key pair with `node scripts/gen-ap-keys.js`.
# Store the PEM contents with literal \n between lines (GitHub/Vercel handle multiline secrets this way).
AP_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----
AP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEowIB...\n-----END RSA PRIVATE KEY-----

# ActivityPub federation — the new actor's key, distinct from the pair
# above (see src/lib/ap-identity.ts). Required for the new domain's /actor
# to resolve; until these are set it 503s with "Actor not yet configured".
AP_PUBLIC_KEY_NEW=-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----
AP_PRIVATE_KEY_NEW=-----BEGIN RSA PRIVATE KEY-----\nMIIEowIB...\n-----END RSA PRIVATE KEY-----

# Vercel KV (Upstash Redis) — create a KV store in the Vercel dashboard and link it to this project.
# These vars are auto-injected in Vercel Functions; add them to GitHub secrets for the Actions fan-out step.
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_TOKEN=your_kv_token_here
